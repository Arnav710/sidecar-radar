{
  "name": "sidecar",
  "private": true,
  "description": "Sidecar: ask the talk anything, live. The people stuck on the same thing become your hallway track.",
  "workspaces": [
    "shared",
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "build": "npm run build -w web && npm run build -w worker",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w worker",
    "test": "npm run test -w shared",
    "es:setup": "tsx scripts/es-setup.ts",
    "seed": "tsx scripts/seed.ts && tsx scripts/seed-people.ts",
    "replay": "tsx scripts/replay-room.ts",
    "demo:traffic": "tsx scripts/demo-traffic.ts",
    "sync:sources": "tsx scripts/sync-sources.ts"
  },
  "devDependencies": {
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "@types/node": "22.15.29"
  },
  "overrides": {
    "@opentelemetry/api": "1.10.0"
  }
}
