# Copy to .env and fill in. Never commit .env.
# In the cluster these come from Secret app-credentials (created by a human, never in git).
ES_URL=
ES_API_KEY=
OPENAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
WORKER_URL=http://localhost:8081

# Side events for the scheduler. Each source is skipped when its keys are empty.
# Luma: iCal feed links of the calendars to follow (Luma calendar > Subscribe > iCal link), comma separated.
LUMA_ICS_URLS=
# Slack: a bot token with channels:history, added to the channels, plus their ids (C0123456789), comma separated.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
# X: bearer token (reading posts needs a paid X API plan) and a search, e.g. (#CloudNativeHackathon OR #KubeCon) -is:retweet
X_BEARER_TOKEN=
X_SEARCH_QUERY=
# Lets a scheduled job call POST /api/sources/sync (send it as the x-sync-token header). Leave empty to keep the route off.
SYNC_TOKEN=
